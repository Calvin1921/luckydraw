# Convex — `npx convex dev` fills these in automatically on first run
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Dev-only: makes every route public so the app can be demoed without a Clerk
# account (middleware.ts). Never enable outside local development.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Dev-only, SERVER side: set as a Convex env var (npx convex env set DEV_BYPASS true)
# to skip org-ownership checks in Convex functions while developing without auth.
# This disables access control — NEVER set it on a deployment holding real data.
DEV_BYPASS=false

# Stripe — only needed for the per-event licensing/checkout path
# (convex/events.ts, convex/http.ts). The draw flow runs without these.
# Set them as Convex environment variables: npx convex env set STRIPE_SECRET_KEY ...
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PER_EVENT_PRICE_ID=price_xxx
